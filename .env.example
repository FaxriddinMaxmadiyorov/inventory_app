# Database (leave empty to use the local socket and your OS user)
DB_HOST=
DB_USER=
DB_PASSWORD=

# Host used in links inside e-mails
APP_HOST=

# Google sign-in: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/users/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in: https://github.com/settings/developers
# Callback URL: http://localhost:3000/users/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudinary (images are uploaded from the browser straight to the cloud).
# Create an *unsigned* upload preset in Settings -> Upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# E-mail (confirmation and password reset letters).
# RESEND_API_KEY: letters go through the Resend HTTP API (works on hosts that block SMTP ports).
# MAILER_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
MAILER_FROM=

# Alternative: plain SMTP. Used only when RESEND_API_KEY is empty.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
