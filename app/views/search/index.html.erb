<% content_for :title, t("search.title") %>

<h1 class="h3 mb-4">
  <% if @tag.present? %>
    <%= t("search.by_tag") %> <span class="badge text-bg-secondary"><%= @tag %></span>
  <% else %>
    <%= t("search.results_for", query: @query) %>
  <% end %>
</h1>

<h2 class="h5"><%= t("search.inventories") %> <span class="text-body-secondary">(<%= @inventories.total_count %>)</span></h2>
<%= render "shared/inventories_table", inventories: @inventories %>
<div class="mt-3"><%= paginate @inventories %></div>

<% if @tag.blank? %>
  <h2 class="h5 mt-4"><%= t("search.items") %> <span class="text-body-secondary">(<%= @items.total_count %>)</span></h2>
  <% if @items.empty? %>
    <p class="text-body-secondary"><%= t("common.nothing_found") %></p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th><%= t("search.inventory") %></th>
            <th class="d-none d-md-table-cell"><%= t("search.matched_text") %></th>
            <th><%= t("items.created_at") %></th>
          </tr>
        </thead>
        <tbody>
          <% @items.each do |item| %>
            <tr>
              <td><%= link_to item.custom_id, inventory_item_path(item.inventory, item), class: "fw-medium" %></td>
              <td><%= link_to item.inventory.title, inventory_path(item.inventory) %></td>
              <td class="d-none d-md-table-cell text-body-secondary"><%= truncate(item.search_text.to_s, length: 90) %></td>
              <td class="text-nowrap"><%= l(item.created_at, format: :short) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="mt-3"><%= paginate @items, param_name: :items_page %></div>
  <% end %>
<% end %>
