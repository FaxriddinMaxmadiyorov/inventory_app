<% if @inventory.image_url.present? || @inventory.description.present? %>
  <div class="d-flex flex-column flex-md-row gap-3 mb-3">
    <% if @inventory.image_url.present? %>
      <%= image_tag @inventory.image_url, class: "rounded border inventory-image", alt: "" %>
    <% end %>
    <div class="flex-grow-1"><%= markdown(@inventory.description) %></div>
  </div>
<% end %>

<div class="d-flex flex-wrap gap-2 align-items-center mb-2">
  <% if @can_write %>
    <div class="btn-toolbar gap-2" data-bulk-toolbar="items-form">
      <%= link_to new_inventory_item_path(@inventory), class: "btn btn-primary btn-sm" do %><i class="bi bi-plus-lg"></i> <%= t("items.add") %><% end %>
      <button type="button" class="btn btn-outline-secondary btn-sm" data-bulk-edit disabled><i class="bi bi-pencil"></i> <%= t("common.edit") %></button>
      <button type="submit" form="items-form" class="btn btn-outline-danger btn-sm" data-bulk-min="1" data-confirm="<%= t('common.confirm_delete') %>" disabled><i class="bi bi-trash"></i> <%= t("common.delete") %></button>
    </div>
  <% end %>
  <%= search_form_for @items_search, url: inventory_path(@inventory), html: { id: "items-search", class: "ms-auto" } do |f| %>
    <%= keep_sort_field %>
    <%= f.search_field :search_text_cont, class: "form-control form-control-sm", placeholder: t("items.filter"), "aria-label": t("items.filter") %>
  <% end %>
</div>

<%= form_with url: bulk_destroy_inventory_items_path(@inventory), method: :delete, id: "items-form" do %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <% if @can_write %><th class="check-col"><input type="checkbox" class="form-check-input" data-bulk-all aria-label="<%= t('common.select_all') %>"></th><% end %>
          <th><%= table_sort_link @items_search, :custom_id, "ID" %></th>
          <% @fields.each do |field| %>
            <th title="<%= field.description %>"><%= table_sort_link @items_search, field.column, field.name %></th>
          <% end %>
          <th><%= table_sort_link @items_search, :created_at, t("items.created_at"), default_order: :desc %></th>
          <th class="text-end"><%= table_sort_link @items_search, :likes_count, content_tag(:i, "", class: "bi bi-heart", title: t("items.likes")), default_order: :desc %></th>
        </tr>
      </thead>
      <tbody>
        <% @items.each do |item| %>
          <tr>
            <% if @can_write %>
              <td><input type="checkbox" class="form-check-input" name="ids[]" value="<%= item.id %>:<%= item.lock_version %>" data-bulk-item data-href="<%= inventory_item_path(@inventory, item) %>" aria-label="<%= item.custom_id %>"></td>
            <% end %>
            <td><%= link_to item.custom_id, inventory_item_path(@inventory, item), class: "fw-medium text-break" %></td>
            <% @fields.each do |field| %>
              <td><%= field_value(item, field) %></td>
            <% end %>
            <td class="text-nowrap"><%= l(item.created_at, format: :short) %></td>
            <td class="text-end"><%= item.likes_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
<% if @items.empty? %>
  <p class="text-body-secondary"><%= ransack_params["search_text_cont"].present? ? t("common.nothing_found") : t("items.empty") %></p>
<% end %>
<%= paginate @items %>
