<div class="row g-3">
  <div class="col-12">
    <div class="card">
      <div class="card-body d-flex align-items-baseline gap-2">
        <span class="display-6"><%= @stats.items_count %></span>
        <span class="text-body-secondary"><%= t("stats.items") %></span>
      </div>
    </div>
  </div>

  <% if @stats.numbers.any? %>
    <div class="col-12">
      <h2 class="h5"><%= t("stats.numeric") %></h2>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th><%= t("stats.field") %></th>
              <th class="text-end"><%= t("stats.filled") %></th>
              <th class="text-end"><%= t("stats.average") %></th>
              <th class="text-end"><%= t("stats.min") %></th>
              <th class="text-end"><%= t("stats.max") %></th>
            </tr>
          </thead>
          <tbody>
            <% @stats.numbers.each do |row| %>
              <tr>
                <td><%= row.field.name %></td>
                <td class="text-end"><%= row.count %></td>
                <td class="text-end"><%= format_number(row.average) %></td>
                <td class="text-end"><%= format_number(row.min) %></td>
                <td class="text-end"><%= format_number(row.max) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <% @stats.popular.each do |entry| %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        <div class="card-header"><%= entry.field.name %> <span class="text-body-secondary small">· <%= t("stats.most_used") %></span></div>
        <ul class="list-group list-group-flush">
          <% entry.values.each do |value, uses| %>
            <li class="list-group-item d-flex justify-content-between gap-2">
              <span class="text-truncate"><%= value %></span><span class="badge text-bg-secondary"><%= uses %></span>
            </li>
          <% end %>
          <% if entry.values.empty? %><li class="list-group-item text-body-secondary"><%= t("stats.no_values") %></li><% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <% if @stats.flags.any? %>
    <div class="col-12">
      <h2 class="h5"><%= t("stats.flags") %></h2>
      <ul class="list-group">
        <% @stats.flags.each do |row| %>
          <li class="list-group-item d-flex justify-content-between">
            <span><%= row.field.name %></span>
            <span><%= t("stats.checked", checked: row.checked, total: @stats.items_count) %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
