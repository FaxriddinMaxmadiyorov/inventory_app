<div data-chat data-url="<%= inventory_posts_path(@inventory) %>">
  <div data-chat-list class="mb-3">
    <%= render partial: "posts/post", collection: @posts %>
  </div>
  <p class="text-body-secondary <%= 'd-none' if @posts.any? %>" data-chat-empty><%= t("posts.empty") %></p>

  <% if user_signed_in? %>
    <form data-chat-form>
      <label for="post-body" class="form-label"><%= t("posts.new") %></label>
      <textarea id="post-body" name="body" class="form-control" rows="3" maxlength="10000" required placeholder="<%= t('posts.placeholder') %>"></textarea>
      <div class="d-flex align-items-center gap-3 mt-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> <%= t("posts.send") %></button>
        <span class="form-text"><%= t("common.markdown_supported") %></span>
        <span class="text-danger small" data-chat-error></span>
      </div>
    </form>
  <% else %>
    <p class="text-body-secondary"><%= link_to t("nav.sign_in"), new_user_session_path %> — <%= t("posts.sign_in_hint") %></p>
  <% end %>
</div>
