<div class="d-grid gap-2 mb-3">
  <%= button_to user_google_oauth2_omniauth_authorize_path, class: "btn btn-outline-secondary w-100", data: { turbo: false } do %>
    <i class="bi bi-google"></i> <%= t("auth.continue_with", provider: "Google") %>
  <% end %>
  <%= button_to user_github_omniauth_authorize_path, class: "btn btn-outline-secondary w-100", data: { turbo: false } do %>
    <i class="bi bi-github"></i> <%= t("auth.continue_with", provider: "GitHub") %>
  <% end %>
</div>
<div class="text-center text-body-secondary small mb-3"><%= t("auth.or_email") %></div>
