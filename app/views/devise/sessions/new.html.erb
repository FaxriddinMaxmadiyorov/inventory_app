<% content_for :title, t("auth.sign_in") %>
<div class="auth-card mx-auto">
  <h1 class="h3 mb-3"><%= t("auth.sign_in") %></h1>
  <%= render "devise/shared/oauth" %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-3">
      <%= f.label :email, t("auth.email"), class: "form-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", required: true %>
    </div>
    <div class="mb-3">
      <%= f.label :password, t("auth.password"), class: "form-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "form-control", required: true %>
    </div>
    <div class="form-check mb-3">
      <%= f.check_box :remember_me, class: "form-check-input" %>
      <%= f.label :remember_me, t("auth.remember_me"), class: "form-check-label" %>
    </div>
    <%= f.submit t("auth.sign_in"), class: "btn btn-primary w-100" %>
  <% end %>
  <%= render "devise/shared/links" %>
</div>
