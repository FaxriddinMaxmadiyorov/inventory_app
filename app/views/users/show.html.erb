<% content_for :title, @user.name %>
<% own = user_signed_in? && current_user.id == @user.id %>

<div class="d-flex align-items-center gap-3 mb-4">
  <i class="bi bi-person-circle display-5 text-body-secondary"></i>
  <div>
    <h1 class="h3 mb-0"><%= @user.name %></h1>
    <div class="text-body-secondary small">
      <%= t("users.member_since", date: l(@user.created_at.to_date, format: :long)) %>
      <% if @user.admin? %><span class="badge text-bg-primary ms-1"><%= t("users.admin") %></span><% end %>
      <% if @user.blocked? %><span class="badge text-bg-danger ms-1"><%= t("users.blocked") %></span><% end %>
    </div>
  </div>
</div>

<h2 class="h5"><%= own ? t("users.my_inventories") : t("users.inventories") %></h2>

<div class="d-flex flex-wrap gap-2 align-items-center mb-2">
  <% if @own_page %>
    <div class="btn-toolbar gap-2" data-bulk-toolbar="owned-form">
      <% if own %>
        <%= button_to inventories_path, class: "btn btn-primary btn-sm" do %><i class="bi bi-plus-lg"></i> <%= t("common.new") %><% end %>
      <% end %>
      <button type="button" class="btn btn-outline-secondary btn-sm" data-bulk-edit disabled><i class="bi bi-pencil"></i> <%= t("common.edit") %></button>
      <button type="submit" form="owned-form" class="btn btn-outline-danger btn-sm" data-bulk-min="1" data-confirm="<%= t('common.confirm_delete') %>" disabled><i class="bi bi-trash"></i> <%= t("common.delete") %></button>
    </div>
  <% end %>
  <%= search_form_for @owned_search, url: user_path(@user), html: { id: "owned-search", class: "ms-auto" } do |f| %>
    <%= keep_sort_field %>
    <%= f.search_field :title_cont, class: "form-control form-control-sm", placeholder: t("common.filter"), "aria-label": t("common.filter") %>
  <% end %>
</div>

<%= form_with url: bulk_destroy_inventories_path, method: :delete, id: "owned-form" do %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <% if @own_page %><th class="check-col"><input type="checkbox" class="form-check-input" data-bulk-all aria-label="<%= t('common.select_all') %>"></th><% end %>
          <th><%= table_sort_link @owned_search, :title, t("inventories.title") %></th>
          <th><%= t("inventories.category") %></th>
          <th class="text-end"><%= table_sort_link @owned_search, :items_count, t("inventories.items"), default_order: :desc %></th>
          <th><%= table_sort_link @owned_search, :created_at, t("inventories.created_at"), default_order: :desc %></th>
        </tr>
      </thead>
      <tbody>
        <% @owned.each do |inventory| %>
          <tr>
            <% if @own_page %>
              <td><input type="checkbox" class="form-check-input" name="ids[]" value="<%= inventory.id %>:<%= inventory.lock_version %>" data-bulk-item data-href="<%= inventory_path(inventory, tab: 'settings') %>" aria-label="<%= inventory.title %>"></td>
            <% end %>
            <td><%= link_to inventory.title, inventory_path(inventory), class: "fw-medium" %></td>
            <td><%= inventory.category&.name %></td>
            <td class="text-end"><%= inventory.items_count %></td>
            <td class="text-nowrap"><%= l(inventory.created_at, format: :short) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @owned.empty? %><p class="text-body-secondary"><%= t("common.nothing_found") %></p><% end %>
<% end %>
<%= paginate @owned %>

<% if @own_page %>
  <h2 class="h5 mt-4"><%= t("users.writable_inventories") %></h2>
  <div class="d-flex mb-2">
    <%= search_form_for @writable_search, as: :wq, url: user_path(@user), html: { id: "writable-search", class: "ms-auto" } do |f| %>
      <%= keep_sort_field :wq %>
      <%= f.search_field :title_cont, class: "form-control form-control-sm", placeholder: t("common.filter"), "aria-label": t("common.filter") %>
    <% end %>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle" id="writable-table">
      <thead>
        <tr>
          <th><%= table_sort_link @writable_search, :title, t("inventories.title") %></th>
          <th><%= t("inventories.creator") %></th>
          <th><%= t("inventories.category") %></th>
          <th class="text-end"><%= table_sort_link @writable_search, :items_count, t("inventories.items"), default_order: :desc %></th>
          <th><%= table_sort_link @writable_search, :created_at, t("inventories.created_at"), default_order: :desc %></th>
        </tr>
      </thead>
      <tbody>
        <% @writable.each do |inventory| %>
          <tr>
            <td><%= link_to inventory.title, inventory_path(inventory), class: "fw-medium" %></td>
            <td><%= link_to inventory.user.name, user_path(inventory.user) %></td>
            <td><%= inventory.category&.name %></td>
            <td class="text-end"><%= inventory.items_count %></td>
            <td class="text-nowrap"><%= l(inventory.created_at, format: :short) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @writable.empty? %><p class="text-body-secondary"><%= t("common.nothing_found") %></p><% end %>
  <%= paginate @writable, param_name: :wpage %>
<% end %>
