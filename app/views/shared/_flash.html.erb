<% { notice: "success", alert: "danger" }.each do |key, style| %>
  <% if flash[key].present? %>
    <div class="alert alert-<%= style %> alert-dismissible fade show" role="alert">
      <%= flash[key] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('common.close') %>"></button>
    </div>
  <% end %>
<% end %>
