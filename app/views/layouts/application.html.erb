<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-bs-theme="<%= current_theme %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? "#{yield(:title)} · #{t('app.name')}" : t("app.name") %></title>
    <%= csrf_meta_tags %>
    <link rel="icon" href="data:,">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.css">
    <%= stylesheet_link_tag "application" %>
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.js"></script>
    <%= yield :head %>
    <%= javascript_include_tag "application", defer: true %>
  </head>

  <body data-i18n="<%= js_translations %>">
    <nav class="navbar navbar-expand-lg bg-body-tertiary border-bottom sticky-top">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand fw-semibold" do %>
          <i class="bi bi-box-seam"></i> <%= t("app.name") %>
        <% end %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="Menu">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="main-nav">
          <%= form_with url: search_path, method: :get, class: "d-flex flex-grow-1 my-2 my-lg-0 mx-lg-4", role: "search" do |f| %>
            <div class="input-group">
              <%= f.search_field :q, value: (params[:q] if controller_name == "search"), class: "form-control", placeholder: t("nav.search_placeholder"), "aria-label": t("nav.search") %>
              <button class="btn btn-outline-secondary" type="submit" title="<%= t('nav.search') %>"><i class="bi bi-search"></i></button>
            </div>
          <% end %>

          <ul class="navbar-nav align-items-lg-center gap-lg-1">
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-translate"></i> <%= t("languages.#{I18n.locale}") %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <% I18n.available_locales.each do |locale| %>
                  <li><%= button_to t("languages.#{locale}"), preferences_path(locale: locale), method: :patch, class: "dropdown-item #{'active' if locale == I18n.locale}" %></li>
                <% end %>
              </ul>
            </li>
            <li class="nav-item">
              <% other_theme = current_theme == "dark" ? "light" : "dark" %>
              <%= button_to preferences_path(theme: other_theme), method: :patch, class: "nav-link btn btn-link", title: t("nav.theme_#{other_theme}") do %>
                <i class="bi <%= current_theme == 'dark' ? 'bi-sun' : 'bi-moon-stars' %>"></i>
                <span class="d-lg-none"><%= t("nav.theme_#{other_theme}") %></span>
              <% end %>
            </li>

            <% if user_signed_in? %>
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="bi bi-person-circle"></i> <%= current_user.name %>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><%= link_to t("nav.my_page"), user_path(current_user), class: "dropdown-item" %></li>
                  <li><%= link_to t("nav.account"), edit_user_registration_path, class: "dropdown-item" %></li>
                  <% if current_user.admin? %>
                    <li><%= link_to t("nav.admin"), admin_users_path, class: "dropdown-item" %></li>
                  <% end %>
                  <li><hr class="dropdown-divider"></li>
                  <li><%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
                </ul>
              </li>
            <% else %>
              <li class="nav-item"><%= link_to t("nav.sign_in"), new_user_session_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to t("nav.sign_up"), new_user_registration_path, class: "btn btn-primary btn-sm ms-lg-2" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
